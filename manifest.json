{
  "manifest_version": 3,
  "name": "ASCharts",
  "version": "1.5.0",
  "description": "A calmer, more personal Class Charts experience with a command palette, themes, accessibility controls, smarter messaging and confetti celebrations.",
  "content_scripts": [
    {
      "matches": [
        "*://*.classcharts.com/*",
        "*://classcharts.com/*"
      ],
      "js": [
        "core.js",
        "content.js",
        "sidebar.js",
        "pages.js",
        "settings.js",
        "concern-modal.js",
        "mycode-modal.js",
        "features.js",
        "palette.js"
      ],
      "css": [
        "style.css",
        "theme.css",
        "settings.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
